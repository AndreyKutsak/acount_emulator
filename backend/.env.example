PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/treds
CLIENT_URL=http://localhost:5173
CREDENTIALS_SECRET=change_this_to_a_long_random_string
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
VPN_CHECK_INTERVAL_MS=300000

# Stealth-шар: локаль і часовий пояс, які емулюються у браузері.
# Залиште порожніми, щоб використовувати стандартні uk-UA / Europe/Kyiv.
STEALTH_LOCALE=uk-UA
STEALTH_TIMEZONE=Europe/Kyiv

# Фоновий планувальник (бот-ферма): автопублікація запланованих постів,
# автозбір метрик і коментарів. Вимкніть SCHEDULER_ENABLED=false, якщо
# автоматика не потрібна.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
