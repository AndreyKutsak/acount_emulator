PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/treds
CLIENT_URL=http://localhost:5173
CREDENTIALS_SECRET=change_this_to_a_long_random_string

# --- Браузерна автоматизація ---
# BROWSER_ENGINE: playwright (за замовчуванням) | patchright (потрібно встановити:
# npm i patchright && npx patchright install chromium). CloakBrowser потребує ліцензії.
BROWSER_ENGINE=playwright
# false = видимий браузер (рекомендовано для перших запусків і серверів з GUI;
# на headless-сервері без GUI використовуйте true або Xvfb)
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_MS=60000

# --- Residential проксі (опційно) ---
# Порожні PROXY_ENDPOINT/PROXY_USERNAME = fallback на пряме/VPN-з'єднання.
PROXY_PROVIDER=oxylabs
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_ENDPOINT=
PROXY_STICKY_DURATION_MIN=30

# --- Профілі та fingerprint ---
# Каталог персистентних браузерних профілів (cookies/localStorage/history на акаунт).
PROFILES_DIR=./profiles
# Локаль і часовий пояс емуляції (fallback, якщо профіль не задає свій).
STEALTH_LOCALE=uk-UA
STEALTH_TIMEZONE=Europe/Kyiv

# --- TLS impersonation (опційно, для прямих HTTP-запитів) ---
TLS_IMPERSONATE=chrome124

# --- Telegram API (MTProto) ---
# api_id / api_hash застосунку з https://my.telegram.org → API development tools.
# Використовуються для всіх Telegram-акаунтів, у яких не задано власну пару.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- VPN-перевірки ---
VPN_CHECK_INTERVAL_MS=300000

# --- Фоновий планувальник (бот-ферма) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# --- Telegram: автокоментування із заготовок ---
# Вимикається також разом із SCHEDULER_ENABLED=false.
TELEGRAM_AUTOCOMMENT_ENABLED=true
# Як часто фоновий цикл перевіряє розклади.
TELEGRAM_AUTOCOMMENT_INTERVAL_MS=30000
# Мінімальна пауза між будь-якими двома автокоментарями одного акаунта (захист від FLOOD_WAIT).
TELEGRAM_AUTOCOMMENT_ACCOUNT_GAP_SEC=60
# Режим "кожен новий пост": як часто перечитувати чат у пошуках нових постів.
TELEGRAM_AUTOCOMMENT_POLL_SEC=120
# Часовий пояс розкладу за замовчуванням (інакше STEALTH_TIMEZONE, інакше Europe/Kyiv).
TELEGRAM_AUTOCOMMENT_TIMEZONE=

# --- Telegram: автовідповіді на особисті повідомлення ---
# Вимикається також разом із SCHEDULER_ENABLED=false.
TELEGRAM_AUTOREPLY_ENABLED=true
# Як часто перевіряти непрочитані особисті чати (на випадок пропущених оновлень).
TELEGRAM_AUTOREPLY_SWEEP_SEC=180

# Рівень логів бібліотеки GramJS: error (за замовчуванням), warn, info, debug.
# info/debug показують підключення і перехід між дата-центрами Telegram.
# Журнал входу в акаунти завжди пишеться в backend/logs/telegram-auth.log.
TELEGRAM_LOG_LEVEL=error
