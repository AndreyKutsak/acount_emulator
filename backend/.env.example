PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/treds
CLIENT_URL=http://localhost:5173
CREDENTIALS_SECRET=change_this_to_a_long_random_string

# --- Браузерна автоматизація ---
# BROWSER_ENGINE: playwright (за замовчуванням) | patchright (потрібно встановити:
# npm i patchright && npx patchright install chromium). CloakBrowser потребує ліцензії.
BROWSER_ENGINE=playwright
# false = видимий браузер (рекомендовано для перших запусків і серверів з GUI;
# на headless-сервері без GUI використовуйте true або Xvfb)
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT_MS=60000

# --- Residential проксі (опційно) ---
# Порожні PROXY_ENDPOINT/PROXY_USERNAME = fallback на пряме/VPN-з'єднання.
PROXY_PROVIDER=oxylabs
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_ENDPOINT=
PROXY_STICKY_DURATION_MIN=30

# --- Профілі та fingerprint ---
# Каталог персистентних браузерних профілів (cookies/localStorage/history на акаунт).
PROFILES_DIR=./profiles
# Локаль і часовий пояс емуляції (fallback, якщо профіль не задає свій).
STEALTH_LOCALE=uk-UA
STEALTH_TIMEZONE=Europe/Kyiv

# --- TLS impersonation (опційно, для прямих HTTP-запитів) ---
TLS_IMPERSONATE=chrome124

# --- VPN-перевірки ---
VPN_CHECK_INTERVAL_MS=300000

# --- Фоновий планувальник (бот-ферма) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000
